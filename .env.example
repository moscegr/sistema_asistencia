# Plantilla de Variables de Entorno para Coolify / Producción 100% Self-Hosted

# Landing page informativa institucional (CBTis 134)
# false = redirige directamente a /login (ideal para multi-escuela DGETI)
# true  = muestra la página de presentación pública
ENABLE_LANDING_PAGE=false

# Credenciales del Administrador Inicial (Seeder MongoDB)
ADMIN_EMAIL=admin@institucion.edu.mx
ADMIN_PASSWORD=

# Cadena de conexión para MongoDB en Coolify
SPRING_DATA_MONGODB_URI=mongodb://root:password@mongodb:27017/asistencia_db?authSource=admin

# Ruta del almacenamiento persistente para archivos subidos
UPLOAD_DIR=/app/uploads
