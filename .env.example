# Plantilla de Variables de Entorno para Coolify / Produccion 100% Self-Hosted

# Credenciales del Administrador Inicial (Seeder MongoDB)
ADMIN_EMAIL=cruz.egr@cbtis134.edu.mx
ADMIN_PASSWORD=

# Cadena de conexion para MongoDB en Coolify
SPRING_DATA_MONGODB_URI=mongodb://root:password@mongodb:27017/cbtis134_db?authSource=admin

# Ruta del almacenamiento persistente para archivos subidos
UPLOAD_DIR=/app/uploads
